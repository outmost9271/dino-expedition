{
  "name": "zhonghua-dinosaur-expedition",
  "version": "1.0.0",
  "private": true,
  "description": "面向六岁儿童的中华恐龙考察益智游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:portable": "tsc -b && vite build --mode portable && node scripts/finish-portable.mjs",
    "preview": "vite preview",
    "voice:generate": "node scripts/generate-voice.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.4",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.6"
  }
}
